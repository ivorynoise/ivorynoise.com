# Copy to `.env.local` for local development (never commit real values).

# PostHog — same names in Docker build (build-args), locally, and at container runtime
# NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=phc_...
# NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Brevo newsletter — BOTH are required for /api/newsletter
# API key: https://app.brevo.com/settings/keys/api
# BREVO_API_KEY=xkeysib-...
#
# List ID: Brevo → CRM → Lists → open a list → ID is in the URL (…/lists/123) or list settings
# BREVO_LIST_ID=123
#
# Docker / ./build.sh: export both BREVO_* before building (same as CI). Final image also sets them
# on the runner stage so /api/newsletter works inside the container.
