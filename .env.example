# Copy to `.env.local` for local development (never commit real values).

# PostHog — same names in Docker build (build-args), locally, and at container runtime
# (Runtime env lets server-side capture work, e.g. newsletter API, even though the key is also inlined for the client at build.)
# NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=phc_...
# Optional — defaults to US cloud ingest (match next.config rewrites if you change region)
# NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# MAILCHIMP_API_KEY=
# MAILCHIMP_LIST_ID=
