{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ivorynoise-com",
  "compatibility_date": "2026-07-16",
  "build": {
    "command": "npm run build"
  },
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  },
  "observability": {
    "enabled": true
  }
}
