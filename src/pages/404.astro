---
import Base from "@/layouts/Base.astro";
import { site } from "@/lib/site";
---

<Base title={`Page not found | ${site.name}`}>
  <section class="site-container" style="padding-block: clamp(2rem, 5vw, 3.25rem)">
    <h1
      class="font-semibold text-nocturne"
      style="font-family: var(--font-serif); font-size: clamp(1.45rem, 3.2vw, 1.95rem)"
    >
      404
    </h1>
    <p class="mt-3 font-sans">
      This page could not be found. <a href="/" class="underline">Go home</a>
    </p>
  </section>
</Base>
