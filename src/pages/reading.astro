---
import Base from "@/layouts/Base.astro";
import { readingByCategory, readingItems, readingSections } from "@/data/reading";
import { inlineLinkClass } from "@/lib/inline-link";

const sections = readingSections
  .map((s) => ({ ...s, items: readingByCategory(s.category) }))
  .filter((s) => s.items.length > 0);

const formatListDate = (date: string) =>
  new Date(date).toLocaleDateString("en-US", {
    month: "short",
    day: "numeric",
    year: "numeric",
  });
---

<Base
  title="Reading | Deepak Aggarwal"
  description="Research papers and insightful blogs — technical and non-technical reading."
>
  <section style="padding-block: clamp(2rem, 5vw, 3.25rem)">
    <div class="site-container w-full">
      <div class="w-full" style="max-width: 42rem">
        <header>
          <h1
            class="text-balance font-semibold leading-[1.1] tracking-tight text-nocturne"
            style="font-family: var(--font-serif); font-size: clamp(1.45rem, 3.2vw, 1.95rem)"
          >
            Reading list<span
              class="font-sans font-normal tabular-nums text-nocturne/45"
              style="font-size: clamp(0.9rem, 1.35vw, 1.05rem)"
              >{` (${readingItems.length})`}</span
            >
          </h1>

          <p class="mt-5 font-sans text-pretty">
            Papers, guides, and posts I have read.
          </p>
          <hr class="mt-8 border-0 border-t border-nocturne/[0.1]" />
        </header>

        {
          sections.map(({ id, title, items }) => (
            <section
              class="mt-8 scroll-mt-20 first:mt-6"
              id={id}
              aria-labelledby={`${id}-heading`}
            >
              <h2
                id={`${id}-heading`}
                class="font-sans text-sm font-semibold uppercase tracking-[0.06em] text-nocturne/55"
              >
                {title}
                <span class="font-normal tabular-nums text-nocturne/40">{` (${items.length})`}</span>
              </h2>
              <ul class="mt-3 list-disc space-y-[0.35rem] pl-4 marker:text-nocturne/25">
                {items.map((item) => (
                  <li class="font-sans text-pretty text-nocturne">
                    {item.date && (
                      <>
                        <time
                          class="font-mono text-[0.8125rem] tabular-nums text-nocturne/48"
                          datetime={item.date}
                        >
                          {formatListDate(item.date)}
                        </time>
                        <span class="text-nocturne/30">{" : "}</span>
                      </>
                    )}
                    <a
                      href={item.url}
                      target="_blank"
                      rel="noopener noreferrer"
                      class={inlineLinkClass}
                    >
                      {item.title}
                    </a>
                  </li>
                ))}
              </ul>
            </section>
          ))
        }
      </div>
    </div>
  </section>
</Base>
